# Use 127.0.0.1 when the collectors run on the PostgreSQL Mac Mini.
# From another computer, replace it with the Mac Mini's LAN IPv4 address.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=investor_db
DB_USER=investor_app
DB_PASSWORD=your_database_password
ORCHESTRATOR_PORT=8090

ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
FRED_API_KEY=your_fred_api_key

WATCHLIST_TICKERS=ADVANC.BK,AOT.BK,BTC-USD,ETH-USD,AAPL,SPY,USDTHB=X
BASE_CURRENCY=THB
REQUEST_TIMEOUT_SECONDS=30
